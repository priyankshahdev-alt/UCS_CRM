# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
#  TEMPLATE ONLY â€” NAMES AND PLACEHOLDERS. NEVER A REAL VALUE.
#
#  A secret committed here is a secret published. Vite/PM2/Vercel do not
#  distinguish, and git keeps it forever. This file previously held the real
#  ADMIN_*, WHATSAPP_MASTER_* and WHATSAPP_VERIFY_TOKEN values; those are now
#  treated as public and MUST be rotated.
#
#  Rules:  https://beingsevak.org  ->  docs/security/SECRETS-MANAGEMENT.md
#  Audit:  npm run security:check
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# â”€â”€â”€â”€ JWT (for Express auth) â”€â”€â”€â”€
# Use a long random value, and a DIFFERENT one per environment. One secret for
# every subsystem means a single leak compromises all of them.
JWT_SECRET=your-jwt-secret

# â”€â”€â”€â”€ Server â”€â”€â”€â”€
PORT=5000

# Realtime: the web client (socket.io-client) and both Flutter apps
# (socket_io_client) require Socket.IO. "socketio" mounts /socket.io on the
# Express server; "uws" is a raw WebSocket transport on WS_PORT that those
# clients cannot handshake with.
WS_PORT=5001
WS_HOST=0.0.0.0
REALTIME_TRANSPORT=socketio
WS_ALLOWED_ORIGINS=*

# â”€â”€â”€â”€ Admin break-glass key â”€â”€â”€â”€
# Gates /api/envadmin, which can read and write every project's .env and
# restart services. When unset the endpoint FAILS OPEN unless the code is
# fixed to fail closed â€” see docs/security/SECURITY.md P0-C. Keep it unset
# outside development.
# ENV_ADMIN_KEY=your-break-glass-admin-key

# â”€â”€â”€â”€ WhatsApp Master Admin â”€â”€â”€â”€
# Master login bypasses all checks. Use this to create/manage users.
WHATSAPP_MASTER_EMAIL=your-master-email@example.com
WHATSAPP_MASTER_PASSWORD=your-master-password

# â”€â”€â”€â”€ WhatsApp Cloud API (Meta) â”€â”€â”€â”€
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_API_VERSION=v23.0
WHATSAPP_WABA_ID=your-waba-id
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
# Meta App ID. Required only for uploading template header images/videos/
# documents from Accounts â†’ WhatsApp Center â†’ Add Template. Get it from
# Meta for Developers â†’ your app â†’ Settings â†’ Basic â†’ App ID.
WHATSAPP_APP_ID=your-meta-app-id
# App secret (Settings â†’ Basic â†’ App Secret). Used for webhook signature checks.
WHATSAPP_APP_SECRET=your-meta-app-secret

# â”€â”€â”€â”€ Meta Lead Ads (Facebook / Instagram) â”€â”€â”€â”€
# Leads arrive at GET/POST /api/webhooks/meta. The access token needs:
#   leads_retrieval, pages_show_list, pages_read_engagement,
#   pages_manage_ads, pages_manage_metadata, ads_management, ads_read
# If omitted, WHATSAPP_ACCESS_TOKEN / WHATSAPP_APP_ID / WHATSAPP_APP_SECRET /
# WHATSAPP_VERIFY_TOKEN are reused (same Meta app).
META_ADS_ACCESS_TOKEN=your-system-user-access-token
META_ADS_APP_ID=your-meta-app-id
META_ADS_APP_SECRET=your-meta-app-secret
META_ADS_VERIFY_TOKEN=your-meta-webhook-verify-token
META_ADS_API_VERSION=v23.0
# Ad account id, with or without the act_ prefix. Required for campaigns and
# insights; lead capture also works without it once a form is mapped.
META_ADS_AD_ACCOUNT_ID=act_your-ad-account-id
# Page id(s) for "Subscribe Page" when discovery through the token is not
# available. Comma separated; also derived from the mapped forms.
# META_ADS_PAGE_ID=
# Webhook callback URL to register in Meta for Developers:
#   https://<your-domain>/api/webhooks/meta

# ---- Google Ads + GA4 ----
# Credentials are DATABASE-ONLY. Add or update them in the app:
#   Accounts -> Modules -> Google Ads & Analytics -> Connection
# They are stored in the `settings` table and masked on read. Do NOT add
# GOOGLE_ADS_* or GA4_PROPERTY_ID here: any values found in .env are ignored
# and scrubbed from the running process at boot.

# â”€â”€â”€â”€ WhatsApp Templates â”€â”€â”€â”€
WHATSAPP_TEMPLATE_NAME=bsct_receipt

# â”€â”€â”€â”€ Admin Seed â”€â”€â”€â”€
# Bootstraps the first super_admin. Change both before the first deploy, and
# note that this file previously shipped the real values â€” rotate them.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# â”€â”€â”€â”€ Database â”€â”€â”€â”€
# Prefer a secret manager or a file outside the repo. A DATABASE_URL with an
# inline password is fine here ONLY as a placeholder.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
#
# Test database. `npm test` refuses to run unless this is set and points at
# /ucs_test, so tests can never touch the live database. First-time setup:
#   1. npm run db:create-test     (needs ADMIN_DATABASE_URL, a CREATEDB role)
#   2. npm run test:db:setup      (builds the schema in ucs_test)
#   3. npm test
# TEST_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/ucs_test
# ADMIN_DATABASE_URL=postgres://ADMIN_USER:PASSWORD@HOST:5432/postgres

# â”€â”€â”€â”€ Database tunnel â”€â”€â”€â”€
# Credentials for the AWS RDS instance reached through the SSH tunnel
# (`npm run tunnel` in backend/). Kept separate from DATABASE_URL on purpose:
# DATABASE_URL usually points at a LOCAL Postgres on the LAN, and those
# credentials are rejected by RDS with "password authentication failed".
# Never put a real password in this file -- it is tracked by git.
# DB_TUNNEL_PGUSER=replace-with-the-rds-user
# DB_TUNNEL_PGPASSWORD=replace-with-the-rds-password
# DB_TUNNEL_PGDATABASE=postgres
# DB_TUNNEL_LOCAL_PORT=15432
# DB_TUNNEL_JUMP_HOST=ec2-user@jump-host
# DB_TUNNEL_KEY=/path/to/ucs-backend.pem

# â”€â”€â”€â”€ Office database tunnel (npm run db:expose / db:connect) â”€â”€â”€â”€
# Reaches the office Postgres from any network. `db:expose` runs ON the office
# box, `db:connect` runs on your laptop. No password here: the connect side
# reads the user and database from DATABASE_URL. See docs/security/LOCAL-DB-TUNNEL.md.
# LOCAL_DB_HOST=127.0.0.1
# LOCAL_DB_PORT=5432
# OFFICE_DB_REMOTE_PORT=15433
# OFFICE_DB_LOCAL_PORT=15435


# â”€â”€â”€â”€ AI Payment Scraper (scrapper/ Android app) â”€â”€â”€â”€
# Shared key the 3 phones send as `X-Scraper-Key`. Used by /api/accounts/scraper/*.
# SCRAPER_DEVICE_KEY=change-me-strong-device-secret

# OCR_SPACE_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=            # Aadhaar photo OCR (parse-photo scraping). https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-3.8-flash
# CALENDARIFIC_API_KEY=      # India festivals + worldwide/UN observances for the Event Head calendar. https://calendarific.com
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=
# IMAP_ENABLED=false
# RAZORPAY_ENABLED=false
# PAYTM_ENABLED=false

# â”€â”€â”€â”€ Optional: Live Google Sheets report (quiz results) â”€â”€â”€â”€
# GOOGLE_SHEET_ID=your-spreadsheet-id
# GOOGLE_SHEET_NAME=Sheet1
# For deployment, pass the service account JSON inline (prefer base64, e.g.:
#   $env:GOOGLE_SERVICE_ACCOUNT = [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# raw inline JSON also works:
# GOOGLE_SERVICE_ACCOUNT={"type":"service_account",...}
# For local dev you may instead use a file path:
# GOOGLE_SERVICE_ACCOUNT=credentials/service-account.json

# â”€â”€â”€â”€ Backup Configuration â”€â”€â”€â”€
# AWS Backup
BACKUP_SCHEDULE=cron(0 2 */2 * ? *)          # Every 2 days at 02:00 UTC
BACKUP_RETENTION_DAYS=28                     # Standard retention (28 days)
BACKUP_MONTHLY_RETENTION_DAYS=365            # Monthly long-term retention
BACKUP_S3_BUCKET=ucs-crm-backups
BACKUP_S3_PREFIX=aws-rds
RDS_INSTANCE_IDENTIFIER=ucs-crm-db
AWS_REGION=ap-south-1

# â”€â”€â”€â”€ Local development database access â”€â”€â”€â”€
# Lets the backend run on your machine against the real AWS database: on boot it
# authorizes your current public IP on the RDS security group (port 5432) and on
# shutdown it removes that rule. Every rule it makes is tagged "ucs-local-dev:"
# and leftovers are swept on the next boot.
#
# Set to true ONLY for local runs. It is ignored on Vercel and on the EC2/PM2
# server. Your AWS key also needs ec2:AuthorizeSecurityGroupIngress and
# ec2:RevokeSecurityGroupIngress, not just the read-only RDS/CloudWatch perms.
# Prefer the SSH tunnel (start-local-db-tunnel.ps1) if you would rather change
# nothing in AWS at all.
LOCAL_DB_ACCESS=false
# How long a leftover rule may sit before the next boot removes it.
LOCAL_DB_ACCESS_RULE_TTL_HOURS=12
# LOCAL_DB_ACCESS_REGION=ap-south-1        # default: AWS_REGION, or parsed from DATABASE_URL
# LOCAL_DB_ACCESS_PORT=5432                # default: the port in DATABASE_URL, else 5432
# LOCAL_DB_ACCESS_IP_URL=https://checkip.amazonaws.com

# â”€â”€â”€â”€ Dual-Account S3 (head + upstream) â”€â”€â”€â”€
# Head = your dev account (default target for db.storage.from('bucket'))
HEAD_AWS_ACCESS_KEY_ID=your-head-access-key
HEAD_AWS_SECRET_ACCESS_KEY=your-head-secret-key
HEAD_S3_BUCKET=ucs-crm-head-uploads
HEAD_S3_REGION=ap-south-1

# Upstream = production account (select via db.storage.from('upstream', 'bucket'))
UPSTREAM_AWS_ACCESS_KEY_ID=your-upstream-access-key
UPSTREAM_AWS_SECRET_ACCESS_KEY=your-upstream-secret-key
UPSTREAM_S3_BUCKET=ucs-crm-uploads-mumbai
UPSTREAM_S3_REGION=ap-south-1

# Legacy single-account fallback (used when HEAD_* not configured)
# S3_BUCKET=ucs-crm-uploads-mumbai
# S3_REGION=ap-south-1

# Lambda pg-dump (optional)
# RDS_PASSWORD=your-rds-password              # Stored in Secrets Manager, not here
# PG_DUMP_PATH=/opt/pg_dump/bin/pg_dump

# In-process memory watchdog (backend self-restarts before OOM on a 2GB box)
# MEM_WATCHDOG_MB=900             # restart if RSS stays above this for GRACE
# MEM_WATCHDOG_GRACE_MS=20000     # sustained-overrun window before SIGTERM
# MEM_WATCHDOG_INTERVAL_MS=5000   # RSS poll interval

# â”€â”€â”€â”€ Sevak Library â”€â”€â”€â”€
# The sevak-library module reads/writes the original Supabase project (schema
# migrated to RDS, but live reads still go to Supabase until cut-over). The
# migration script (scripts/migrate-sevak-library.mjs) requires both.
SEVAK_SUPABASE_URL=https://<project>.supabase.co
SEVAK_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the standalone Sevak Library app, used in payment/renewal email
# buttons. Defaults to https://api.beingsevak.org/sevak-library
# SEVAK_APP_URL=https://api.beingsevak.org/sevak-library

# Gmail account Sevak Library sends its membership / payment / coupon emails
# from. Separate from the bulk-email account below; the literals in
# sevakLibrary/services/email.service.js are the fallback when these are unset.
# LIBRARY_GMAIL_USER=library.sevak@gmail.com
# LIBRARY_GMAIL_APP_PASSWORD=your-16-char-app-password

# --- Bulk Email (Accounts > Modules > Bulk Email) -----------------------------
# Sender accounts are managed in the app: Accounts > Bulk Email > Send from
# > Add sender. Each sender's email, password and SMTP server are stored in the
# bulk_email_senders table, so campaigns can be sent through any SMTP provider
# (Gmail app password, Hostinger mailbox password, Brevo, SES, Zoho…).
# Presets in the UI only prefill the SMTP server; host and port stay editable.
#
# The two variables below are only used once, to seed the first sender when the
# table is still empty (migration from the old env-only sender). Once a sender
# exists in the database they can be removed.
# GMAIL_USER=beingsevakngo@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password
# Public base URL used to build absolute image URLs for HTML email templates.
# Set this in production so saved images stay reachable from the recipient's
# email client (falls back to the request host when unset).
# EMAIL_ASSET_BASE_URL=https://api.beingsevak.org
# Public API origin used in unsubscribe links (falls back to request host).
# PUBLIC_API_URL=https://api.beingsevak.org
# Secret used to sign unsubscribe links. Falls back to JWT_SECRET when unset.
# Use a long random value in production.
# UNSUBSCRIBE_SECRET=your-long-random-unsubscribe-secret
# Campaign sending pace. Emails go out in small parallel batches with a pause
# between them so a large send stays under the provider's rate limits.
# Defaults: 5 emails per batch, 6 seconds between batches, 3 SMTP connections.
# For a new mailbox that is warming up, slow it down a lot, e.g.:
#   BULK_EMAIL_BATCH_SIZE=2
#   BULK_EMAIL_BATCH_DELAY_MS=15000
#   SMTP_MAX_CONNECTIONS=1
# BULK_EMAIL_BATCH_SIZE=5
# BULK_EMAIL_BATCH_DELAY_MS=6000
# SMTP_MAX_CONNECTIONS=3
# How often the sender inbox is polled for the Bulk Email > Mailbox tab.
# Default 120000 (2 minutes). New mail is pushed to open tabs over the realtime
# socket, so this only controls how often IMAP is checked. Minimum 30000.
# MAILBOX_SYNC_INTERVAL_MS=120000
# Inbound replies to campaigns are captured by polling the sender inbox over
# IMAP and creating a "Bulk Email" lead (status: replied). Configure the IMAP
# account either in Accounts > Email Import, or here with an App Password.
# IMAP_USER=library.sevak@gmail.com
# IMAP_PASS=your-16-char-app-password
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993

# WhatsApp template bulk sending pace (server-side background campaign).
# Defaults: 5 recipients per batch, 5 seconds between batches.
# WHATSAPP_BULK_BATCH_SIZE=5
# WHATSAPP_BULK_BATCH_DELAY_MS=5000

# --- Temporary Data Access (admin-granted, time-boxed FRO station access) -----
# Feature flag ï¿½ the rollout/rollback switch. When not "true":
#   ï¿½ authorization reads zero grants (permanent access unaffected)
#   ï¿½ /api/ngo-admin/temporary-access* routes answer 503

# --- OpenWA gateway proxy ----------------------------------------------------
# The CRM backend proxies /api/openwa/* to an external OpenWA gateway. Leave
# OPENWA_GATEWAY_URL unset to disable the feature (the routes then answer 503).
# The gateway exposes its session API under /api/sessions and authenticates
# requests with the X-API-Key header.
# OPENWA_GATEWAY_URL=http://localhost:3100
# OPENWA_GATEWAY_API_KEY=your-gateway-api-key
# OPENWA_GATEWAY_TIMEOUT_MS=15000

GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------------------
# Media storage (AWS S3 removed). Files live under C:\UcsCrmMedia and are
# served by the backend at /api/media/*. Set MEDIA_STORAGE=s3 only to roll back.
# ---------------------------------------------------------------------------
MEDIA_STORAGE=local
LOCAL_MEDIA_DIR=C:\UcsCrmMedia
# LAN address for office browsers. For WhatsApp/Meta outbound (template
# headers, receipt PDFs) use the public HTTPS URL instead, e.g. the Tailscale
# host served by start.bat:
# MEDIA_PUBLIC_BASE_URL=https://win-13itdvn82hk.tail703dea.ts.net
MEDIA_PUBLIC_BASE_URL=http://192.168.1.100:5000
