# ──── JWT (for Express auth) ────
JWT_SECRET=your-jwt-secret

# ──── Server ────
PORT=5000

# ──── WhatsApp Master Admin ────
# Master login bypasses all checks. Use this to create/manage users.
WHATSAPP_MASTER_EMAIL=admin@whatsapp.com
WHATSAPP_MASTER_PASSWORD=Admin123!

# ──── WhatsApp Cloud API (Meta) ────
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_API_VERSION=v23.0
WHATSAPP_WABA_ID=your-waba-id
WHATSAPP_VERIFY_TOKEN=ucscompany123

# ──── WhatsApp Templates ────
WHATSAPP_TEMPLATE_NAME=bsct_receipt

# ──── Admin Seed ────
ADMIN_EMAIL=admin@ufs.com
ADMIN_PASSWORD=123456

# ──── Optional: OCR, Firebase, Groq, Razorpay, IMAP, Paytm ────
# ──── Env/Server admin dashboard (/env-admin) ────
# ENV_ADMIN_KEY=9d5c8bc11f6baa0007300a14d2cf1ad0bbf6e7cfbd25024e

# ──── AI Payment Scraper (scrapper/ Android app) ────
# Shared key the 3 phones send as `X-Scraper-Key`. Used by /api/accounts/scraper/*.
# SCRAPER_DEVICE_KEY=change-me-strong-device-secret

# OCR_SPACE_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=            # Aadhaar photo OCR (parse-photo scraping). https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-3.8-flash
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=
# IMAP_ENABLED=false
# RAZORPAY_ENABLED=false
# PAYTM_ENABLED=false

# ──── Optional: Live Google Sheets report (quiz results) ────
# GOOGLE_SHEET_ID=your-spreadsheet-id
# GOOGLE_SHEET_NAME=Sheet1
# For deployment, pass the service account JSON inline (prefer base64, e.g.:
#   $env:GOOGLE_SERVICE_ACCOUNT = [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# raw inline JSON also works:
# GOOGLE_SERVICE_ACCOUNT={"type":"service_account",...}
# For local dev you may instead use a file path:
# GOOGLE_SERVICE_ACCOUNT=credentials/service-account.json

# ──── Backup Configuration ────
# AWS Backup
BACKUP_SCHEDULE=cron(0 2 */2 * ? *)          # Every 2 days at 02:00 UTC
BACKUP_RETENTION_DAYS=28                     # Standard retention (28 days)
BACKUP_MONTHLY_RETENTION_DAYS=365            # Monthly long-term retention
BACKUP_S3_BUCKET=ucs-crm-backups
BACKUP_S3_PREFIX=aws-rds
RDS_INSTANCE_IDENTIFIER=ucs-crm-db
AWS_REGION=ap-south-1

# ──── Dual-Account S3 (head + upstream) ────
# Head = your dev account (default target for db.storage.from('bucket'))
HEAD_AWS_ACCESS_KEY_ID=your-head-access-key
HEAD_AWS_SECRET_ACCESS_KEY=your-head-secret-key
HEAD_S3_BUCKET=ucs-crm-head-uploads
HEAD_S3_REGION=ap-south-1

# Upstream = production account (select via db.storage.from('upstream', 'bucket'))
UPSTREAM_AWS_ACCESS_KEY_ID=your-upstream-access-key
UPSTREAM_AWS_SECRET_ACCESS_KEY=your-upstream-secret-key
UPSTREAM_S3_BUCKET=ucs-crm-uploads-mumbai
UPSTREAM_S3_REGION=ap-south-1

# Legacy single-account fallback (used when HEAD_* not configured)
# S3_BUCKET=ucs-crm-uploads-mumbai
# S3_REGION=ap-south-1

# Lambda pg-dump (optional)
# RDS_PASSWORD=your-rds-password              # Stored in Secrets Manager, not here
# PG_DUMP_PATH=/opt/pg_dump/bin/pg_dump

# In-process memory watchdog (backend self-restarts before OOM on a 2GB box)
# MEM_WATCHDOG_MB=900             # restart if RSS stays above this for GRACE
# MEM_WATCHDOG_GRACE_MS=20000     # sustained-overrun window before SIGTERM
# MEM_WATCHDOG_INTERVAL_MS=5000   # RSS poll interval
