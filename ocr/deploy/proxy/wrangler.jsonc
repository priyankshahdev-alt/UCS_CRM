{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ucs-ocr-proxy",
  "main": "src/index.js",
  // Set this to today's date.
  "compatibility_date": "2026-11-28",
  "observability": {
    "enabled": true
  },
  "vars": {
    // The *.trycloudflare.com URL printed by `cloudflared tunnel --url`.
    // Changes whenever the tunnel restarts; update this and redeploy.
    "TARGET_URL": "https://replace-me.trycloudflare.com"
  }
}
