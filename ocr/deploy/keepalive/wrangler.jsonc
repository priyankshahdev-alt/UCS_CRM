{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ucs-ocr-keepalive",
  "main": "src/index.js",
  // Set this to today's date.
  "compatibility_date": "2026-11-28",
  "observability": {
    "enabled": true
  },
  "triggers": {
    // Render spins a Free web service down after 15 minutes without inbound
    // traffic, so 10 minutes leaves 5 minutes of slack for cron jitter.
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    // URL Render assigned to the OCR service.
    "TARGET_URL": "https://ocr-iuuz.onrender.com/api/status"
  }
}
