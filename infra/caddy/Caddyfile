# Common security headers
(common_security_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		X-Frame-Options           "DENY"
		Referrer-Policy           "strict-origin-when-cross-origin"
		Permissions-Policy        "geolocation=(), microphone=(), camera=(), payment=()"
		-Server
	}
}

api.beingsevak.org, 13-207-47-116.sslip.io {
	import common_security_headers
	request_body {
		max_size 12MB
	}

	# uWebSockets.js is a plain HTTP/WS listener on 5001 - it has no TLS. Browser
	# clients on an HTTPS page must use wss://, so terminate TLS here and forward
	# the upgrade to the internal port. Caddy handles the Upgrade/Connection
	# headers for reverse_proxy automatically.
	handle /ws* {
		reverse_proxy 127.0.0.1:5001
	}

	handle {
		reverse_proxy 127.0.0.1:5000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}
}

aflf.ngo, www.aflf.ngo {
    root * /var/www/aflf
    encode gzip
    try_files {path} /index.html
    file_server
}

