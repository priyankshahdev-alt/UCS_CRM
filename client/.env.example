# ──── API Backend ────
# Points to your Express backend (local or deployed)
VITE_API_URL=https://api.beingsevak.org/api

# ──── Realtime Socket ────
# API origin (optional; defaults to VITE_API_URL with /api stripped).
# The socket host is derived from this, not from the page host, so a client
# served from another machine on the LAN still finds the realtime server.
VITE_SOCKET_URL=https://api.beingsevak.org

# ──── Community Chat ────
# No configuration. Community always talks to the real backend
# (GET/POST /api/chat/* plus the socket.io chat namespace).
#
# The VITE_CHAT_MOCK switch and client/src/components/chat/chatMock.js have been
# removed. The mock shipped to production twice - once because an absent
# variable meant "on", and once because a verification grepped for a string the
# mock never contained - and real users saw an invented "Priya Nair" posting
# invented replies. Nothing is left to switch on, so nothing can be misconfigured.
# For fixtures, keep them outside src (scratch branch, Storybook, or a test
# helper) and do not import them from the shipped path.


# Realtime (uWebSockets.js)
# On HTTPS pages this MUST go through the reverse proxy on 443: uWS listens as
# plain HTTP on 5001 and cannot complete a TLS handshake.
VITE_WS_URL=wss://api.beingsevak.org/ws

# ──── LAN development ────
# Backend + realtime on 192.168.1.152, dev server reachable at
# http://192.168.1.154:5173 (vite.config.js sets server.host = true).
#
# VITE_API_URL=http://192.168.1.152:5000/api
# VITE_SOCKET_URL=http://192.168.1.152:5000
# VITE_WS_URL=ws://192.168.1.152:5001

# Show network/debug details in the browser console (true/false)
VITE_SHOW_NETWORK_DETAIL=true
