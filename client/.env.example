# ──── API Backend ────
# Points to your Express backend (local or deployed)
VITE_API_URL=https://3-6-189-66.sslip.io/api

# ──── Realtime Socket ────
# Socket.io server URL (optional; defaults to VITE_API_URL with /api stripped)
VITE_SOCKET_URL=https://3-6-189-66.sslip.io

# ──── Community Chat ────
# true  = in-memory demo data (client/src/components/chat/chatMock.js)
# false = real backend: GET/POST /api/chat/* + the socket.io chat namespace
#
# The real routes are live and verified (backend/scripts/test-chat-http.mjs,
# test-chat-notifications.mjs). Set to false for a real deployment. The backend
# must be running AND have /api/chat mounted, otherwise the list call 404s and
# the UI shows a locked state.
VITE_CHAT_MOCK=true

